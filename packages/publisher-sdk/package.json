{
  "name": "@specify-sh/publisher-sdk",
  "version": "1.0.0",
  "description": "JS SDK for Specify Publishers",
  "keywords": [
    "specify",
    "publisher-sdk",
    "cptx"
  ],
  "homepage": "https://github.com/InternetCommunityCompany/specify-sdks#readme",
  "bugs": "https://github.com/InternetCommunityCompany/specify-sdks/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InternetCommunityCompany/specify-sdks.git",
    "directory": "packages/publisher-sdk"
  },
  "license": "MIT",
  "author": "Specify",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-server": {
        "types": "./dist/index.d.ts",
        "default": "./dist/react-server.js"
      },
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "react-server": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.react-server.js"
      },
      "default": "./dist/react.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build.mts",
    "types": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@specify-sh/core": "0.1.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
